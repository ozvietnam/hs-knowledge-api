# HS Knowledge API — Local env example
# Copy to .env.local and fill in real values

# Postgres — CÙNG instance với ERP (Supabase shared)
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=hs_kb&pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?schema=hs_kb

# Gemini API — reuse từ ERP
GEMINI_API_KEY=AIza...
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_RERANK_MODEL=models/gemini-2.0-flash
GEMINI_DESCRIBE_MODEL=models/gemini-2.0-flash
GEMINI_EXTRACT_MODEL=models/gemini-2.0-flash

# Token cho ERP gọi (generate: openssl rand -hex 32)
HS_KB_API_TOKEN=

# Cron secret cho /api/cron/* routes (generate: openssl rand -hex 32)
CRON_SECRET=

# Embed pipeline tuning
EMBED_BATCH_SIZE=100
EMBED_RATE_LIMIT_MS=4000
